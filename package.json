{
  "name": "vue-plugin-hiprint",
  "description": "hiprint for Vue2.x / Vue3.x 支持拖拽(分页(不分页)、表头表脚、样式设置、复制粘贴、缩放、撤销重做)生成打印模板、导出json模板数据、静默打印/获取MAC地址(借助客户端)",
  "version": "0.0.61-beta6",
  "author": "CcSimple",
  "license": "MIT",
  "main": "dist/vue-plugin-hiprint.js",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/zhenyu-cpu/vue-plugin-hiprint.git"
  },
  "bugs": {
    "url": "https://github.com/zhenyu-cpu/vue-plugin-hiprint/issues"
  },
  "keywords": [
    "vue",
    "hiprint",
    "print"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "serve": "vite",
    "build-demo": "vite build",
    "build": "vite build --config vite.config.lib.js",
    "up-version": "node ./scripts/change-version.js"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitejs/plugin-vue-jsx": "^4.1.0",
    "ant-design-vue": "^4.2.6",
    "bootstrap": "^3.3.7",
    "concurrent-tasks": "^1.0.7",
    "cross-env": "^7.0.3",
    "less": "^4.2.0",
    "vue": "^3.5.13",
    "vue-ls": "^4.0.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@claviska/jquery-minicolors": "^2.3.6",
    "bwip-js": "^4.0.0",
    "canvg": "^3.0.10",
    "jquery": "^3.6.0",
    "jsbarcode": "^3.11.5",
    "jspdf": "^2.5.1",
    "lodash": "^4.17.21",
    "nzh": "^1.0.8",
    "socket.io-client": "^4.5.1",
    "dom-to-image-more": "3.7.2"
  }
}